# Copy this file to .env and fill in your own values.
# The .env file is git-ignored; never commit real credentials.

# Credentials for the admin account. This is the only account marked as
# admin (is_admin = 1) in the database. Any other users, if added later,
# will be non-admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: path to the SQLite database file.
# Defaults to ./data/enia.db when unset.
# DATABASE_PATH=./data/enia.db
